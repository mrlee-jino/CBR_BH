# Public project settings. Never put a secret/service-role key in these variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical origin used for email verification/recovery redirects.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server only: enter securely in Vercel/environment settings, never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
