{
  "name": "puyohub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node scripts/with-local-env.mjs playwright test",
    "check": "node scripts/with-local-env.mjs npm run check:app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node scripts/start-supabase.mjs",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/generate-types.mjs",
    "test:setup": "node scripts/local-supabase.mjs",
    "test:db": "node --test --test-concurrency=1 tests/database/*.test.mjs",
    "check:app": "npm run format:check && npm run lint && npm run typecheck && npm run test:db && npm run build && playwright test",
    "db:bundle": "node scripts/bundle-migrations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
